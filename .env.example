VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push — สร้างคีย์ด้วย: npx web-push generate-vapid-keys
# ใส่ publicKey ที่นี่ (privateKey ไปตั้งเป็น Edge secret แทน)
VITE_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key-here

# Realtime: apply supabase/migrations/20260519120000_enable_realtime_publication.sql
# (Dashboard → Database → Replication, or `supabase db push`)

# อัปโหลดรูป → Edge Function upload-drive-image (Google Drive OAuth)
# Supabase Edge secrets (ไม่ใส่ใน .env นี้):
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN
#   GOOGLE_DRIVE_FOLDER_ID_BEFORE — รูปก่อนเท
#   GOOGLE_DRIVE_FOLDER_ID_AFTER  — รูปหลังเท
#   GOOGLE_DRIVE_FOLDER_ID_BILL   — บิลคอนกรีต (eslip)
#   GOOGLE_DRIVE_FOLDER_ID (optional fallback)
#   .\scripts\set-upload-drive-oauth-secrets.ps1 -ClientId ... -BeforeFolderId ... -AfterFolderId ... -BillFolderId ...
# แล้ว: npm run deploy:upload-drive-image

# Web Push → Edge Function send-push
# Supabase Edge secrets (ไม่ใส่ใน .env นี้):
#   WEB_PUSH_VAPID_PUBLIC_KEY  — คู่กับ VITE_WEB_PUSH_PUBLIC_KEY
#   WEB_PUSH_VAPID_PRIVATE_KEY — จาก npx web-push generate-vapid-keys
#   WEB_PUSH_VAPID_SUBJECT     — mailto:admin@yourdomain.com
# แล้ว: npm run deploy:send-push
# Migration: supabase/migrations/20260522180000_user_push_subscriptions.sql

# Auto push เมื่อ Request เปลี่ยน → Edge Function notify-request-change
# (optional) PUSH_INTERNAL_SECRET — สำหรับเรียกจาก DB trigger / cron ในอนาคต
# แล้ว: npm run deploy:notify-request-change
# Migration: supabase/migrations/20260522190000_push_notify_events.sql
